# 🌍 Configuração de Ambiente para SnapEats API Documentation
# =========================================================
# 
# Este arquivo contém todas as variáveis de ambiente necessárias
# para executar a documentação da API SnapEats.
# 
# INSTRUÇÕES:
# 1. Copie este arquivo para .env: cp .env.example .env
# 2. Ajuste os valores conforme seu ambiente
# 3. Mantenha este arquivo seguro (não comite senhas)

# 🔐 Segurança e Autenticação
FLASK_SECRET_KEY=sua-chave-secreta-muito-segura-aqui-2024
JWT_SECRET_KEY=outra-chave-secreta-para-jwt-tokens
CORS_ORIGINS=http://localhost:4200,https://app.snapeats.com

# 🗄️ Configuração do Banco de Dados
DB_HOST=localhost
DB_PORT=3306
DB_NAME=snapeats
DB_USER=snapeats_user
DB_PASSWORD=senha-do-banco-muito-segura
DB_URL=mysql+pymysql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# 🍽️ Configuração da Aplicação
APP_NAME=SnapEats API
APP_VERSION=1.0.0
APP_DESCRIPTION=Sistema de delivery de comida com funcionalidades avançadas
ENVIRONMENT=development
DEBUG=false

# 📚 Configuração da Documentação
DOC_VERSION=1.0.0
API_TITLE=SnapEats API
API_DESCRIPTION=API completa para sistema de delivery com restaurantes, clientes, pratos e avaliações
CONTACT_NAME=Equipe SnapEats
CONTACT_EMAIL=suporte@snapeats.com
CONTACT_URL=https://snapeats.com/contato
LICENSE_NAME=MIT
LICENSE_URL=https://opensource.org/licenses/MIT

# 🌐 URLs e Hosts
BASE_URL=http://localhost:5000
DOCS_URL=http://localhost:5000/docs
FRONTEND_URL=http://localhost:4200
API_HOST=0.0.0.0
API_PORT=5000

# 🔧 Configuração do Gunicorn (Produção)
GUNICORN_WORKERS=4
GUNICORN_WORKER_CLASS=sync
GUNICORN_TIMEOUT=30
GUNICORN_KEEPALIVE=5
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100
GUNICORN_LOG_LEVEL=info

# 📊 Configuração de Monitoramento
ENABLE_MONITORING=true
MONITOR_INTERVAL=300
DOCS_MONITOR_INTERVAL=300
DOCS_ALERT_EMAIL=alerts@snapeats.com
DOCS_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# 🗄️ Configuração do Redis (Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# 📧 Configuração de Email (Alertas)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@snapeats.com
SMTP_PASSWORD=senha-do-email-aqui
EMAIL_FROM=SnapEats API <noreply@snapeats.com>

# 🔔 Configuração de Notificações
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/DISCORD/WEBHOOK

# 🏥 Configuração de Health Check
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10
HEALTH_CHECK_RETRIES=3

# 🌍 Configuração de Ambientes
# development | staging | production
FLASK_ENV=development

# 🕐 Configuração de Timezone
TZ=America/Sao_Paulo

# 📈 Configuração de Métricas (Opcional)
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=8000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin123

# 🔒 Configuração SSL (Produção)
SSL_ENABLED=false
SSL_CERT_PATH=/etc/ssl/certs/snapeats.crt
SSL_KEY_PATH=/etc/ssl/private/snapeats.key

# 🐳 Configuração Docker
DOCKER_REGISTRY=registry.snapeats.com
IMAGE_TAG=latest
COMPOSE_PROJECT_NAME=snapeats-docs

# 📝 Configuração de Logs
LOG_LEVEL=INFO
LOG_FORMAT=detailed
LOG_FILE=/app/logs/snapeats-api.log
LOG_MAX_SIZE=10MB
LOG_BACKUP_COUNT=5

# 🌐 Configuração de CORS
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=86400

# 🔐 Configuração de Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100 per hour
RATE_LIMIT_STORAGE_URL=${REDIS_URL}

# 🍰 Configuração do Firebase (se usando)
FIREBASE_PROJECT_ID=snapeats-f8ca0
FIREBASE_PRIVATE_KEY_ID=seu-private-key-id-aqui
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSUA-CHAVE-PRIVADA-AQUI\n-----END PRIVATE KEY-----"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@snapeats-f8ca0.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=sua-client-id-aqui
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token

# 🎯 Configurações Específicas por Ambiente

# ========= DESENVOLVIMENTO =========
# Descomentar para ambiente de desenvolvimento
# FLASK_ENV=development
# DEBUG=true
# API_HOST=localhost
# BASE_URL=http://localhost:5000
# CORS_ORIGINS=http://localhost:4200

# ========= HOMOLOGAÇÃO =========
# Descomentar para ambiente de homologação
# FLASK_ENV=staging
# DEBUG=false
# API_HOST=api-stage.snapeats.com
# BASE_URL=https://api-stage.snapeats.com
# DOCS_URL=https://docs-stage.snapeats.com
# CORS_ORIGINS=https://stage.snapeats.com

# ========= PRODUÇÃO =========
# Descomentar para ambiente de produção
# FLASK_ENV=production
# DEBUG=false
# API_HOST=api.snapeats.com
# BASE_URL=https://api.snapeats.com
# DOCS_URL=https://docs.snapeats.com
# CORS_ORIGINS=https://app.snapeats.com
# SSL_ENABLED=true
# PROMETHEUS_ENABLED=true

# 🚨 IMPORTANTE:
# - Mantenha este arquivo seguro
# - Use senhas fortes e únicas
# - Atualize regularmente as chaves de segurança
# - Configure monitoramento em produção
# - Ative SSL/TLS em produção