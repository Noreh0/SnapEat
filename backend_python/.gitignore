# =============================================================================
# SnapEats Backend - Git Ignore
# =============================================================================
# Este arquivo especifica arquivos e diretórios que NÃO devem ser versionados
# =============================================================================

# 🔐 Arquivos de Credenciais e Configuração Sensível
# -----------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.pem
*.key
*.p12
*.pfx

# 🔥 Firebase Credentials (CRÍTICO - NÃO COMMITAR!)
*firebase*.json
*firebase*adminsdk*.json
firebase-credentials.json
serviceAccountKey.json

# ☁️ Azure Credentials
azure-credentials.json
*.publishsettings

# 🗄️ Banco de Dados
*.sql
*.db
*.sqlite
*.sqlite3
*.dump
*.backup

# 🐍 Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# 🧪 Testes e Cobertura
# -----------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
*.log
.hypothesis/
.tox/
.nox/

# 🔧 Virtual Environments
# -----------------------------------------------------------------------------
venv/
ENV/
env/
.venv/
.ENV/
.env/
env.bak/
venv.bak/

# 🎯 IDEs e Editores
# -----------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*.sublime-project
*.sublime-workspace
.project
.pydevproject
.settings/

# 📦 Dependências e Pacotes
# -----------------------------------------------------------------------------
node_modules/
bower_components/

# 📝 Logs e Temporários
# -----------------------------------------------------------------------------
*.log
logs/
*.tmp
*.temp
temp/
tmp/

# 🖼️ Uploads e Arquivos Estáticos
# -----------------------------------------------------------------------------
static/uploads/*
!static/uploads/.gitkeep

# 🐳 Docker
# -----------------------------------------------------------------------------
docker-compose.override.yml

# 📊 Dados e Modelos de IA (grandes arquivos)
# -----------------------------------------------------------------------------
*.h5
*.pkl
*.joblib
*.model
models/trained/
data/raw/
data/processed/

# 🔍 Outros
